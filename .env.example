# Copiar a .env y ajustar. `./gradlew bootRun` carga este archivo como variables de entorno.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar
DB_NAME=barber
DB_URL=jdbc:postgresql://localhost:5432/barber

# Origen del frontend (Vite)
CORS_ORIGIN=http://localhost:5173

# Secreto JWT: mínimo 32 caracteres (HS256). Nunca subir el valor real al repositorio.
JWT_SECRET=cambiar_por_un_secreto_largo_de_al_menos_32_caracteres

# Administrador inicial. Solo se crea si no existe ningún usuario con rol Administrador.
APP_SEED_ADMIN_EMAIL=gustavo.laime@houseofcut.bo
APP_SEED_ADMIN_PASSWORD=cambiar
APP_SEED_ADMIN_NOMBRE=Gustavo Laime

# Correo del proyecto (Gmail + contraseña de aplicación de 16 letras, sin espacios).
# Vacío = los correos se escriben en el log del backend en vez de enviarse.
MAIL_USERNAME=
MAIL_PASSWORD=

# Proveedor de correo: smtp (por defecto, usa MAIL_USERNAME/MAIL_PASSWORD) o brevo (API HTTPS, la de Railway).
# Con brevo son obligatorias BREVO_API_KEY (Brevo → SMTP y API → Claves API) y MAIL_FROM (remitente verificado).
APP_CORREO_PROVEEDOR=smtp
BREVO_API_KEY=
MAIL_FROM=

# URL del frontend para los enlaces de invitación (por defecto http://localhost:5173).
APP_FRONTEND_URL=
